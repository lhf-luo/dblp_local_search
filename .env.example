# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DBLP_API_TOKEN=replace-with-a-long-random-token
# Change to the server's LAN IP to allow LAN clients; do not expose publicly.
DBLP_BIND_ADDRESS=127.0.0.1
DBLP_PORT=8000
TZ=Asia/Shanghai
DBLP_UPDATE_CRON=0 3 * * 0
DBLP_QUERY_TIMEOUT=15
DBLP_MIN_RECORD_RATIO=0.8
